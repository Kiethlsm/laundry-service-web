  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main booking and submit action.",
      "html": "<button class=\"ds-primary\">Đặt lịch lấy đồ</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:12px 24px;background:var(--blue);color:#fff;border:0;border-radius:12px;font:600 14px \"Be Vietnam Pro\",sans-serif;transition:background-color 160ms ease-out;cursor:pointer}.ds-primary:hover:not(:disabled){background:var(--blue-hover)}.ds-primary:disabled{opacity:.58;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid var(--blue);outline-offset:5px}@media(max-width:760px){.ds-primary{min-height:48px;padding-inline:19px;font-size:12px}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Secondary navigation beside primary actions.",
      "html": "<a class=\"ds-text\" href=\"#booking\">Xem bảng giá <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>",
      "css": ".ds-text{display:inline-flex;align-items:center;gap:12px;min-height:44px;color:var(--ink);font:600 14px \"Be Vietnam Pro\",sans-serif;text-decoration:none}.ds-text:hover{color:var(--blue);text-decoration:underline}.ds-text:focus-visible{outline:3px solid var(--blue);outline-offset:5px}@media(max-width:760px){.ds-text{font-size:12px;gap:10px}}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "field",
      "description": "Standard customer detail input.",
      "html": "<label class=\"ds-label\">Số điện thoại<input class=\"ds-field\" type=\"tel\" placeholder=\"Nhập số điện thoại\"/></label>",
      "css": ".ds-label{display:block;color:var(--ink);font:500 13px/1.7 \"Be Vietnam Pro\",sans-serif}.ds-field{display:block;width:100%;min-height:47px;margin-top:8px;padding:11px 13px;border:1px solid #b6c1cb;border-radius:7px;background:var(--white);color:var(--ink);font:400 15px/1.7 \"Be Vietnam Pro\",sans-serif;transition:border-color 150ms}.ds-field::placeholder{color:#677385;opacity:1}.ds-field:focus{border-color:var(--blue)}.ds-field:disabled{background:var(--pale)}.ds-field:focus-visible{outline:3px solid var(--blue);outline-offset:5px}@media(max-width:760px){.ds-field{font-size:16px}}"
    },
    {
      "name": "Category selector",
      "kind": "chip",
      "refersTo": "selector",
      "description": "Category filter with explicit selected state.",
      "html": "<button class=\"ds-selector\" aria-pressed=\"true\">Giặt sấy</button> <button class=\"ds-selector\" aria-pressed=\"false\">Giặt giày</button>",
      "css": ".ds-selector{border:1px solid #bbc8d4;background:transparent;border-radius:6px;min-height:40px;padding:8px 16px;color:var(--ink);font:400 12px/1.7 \"Be Vietnam Pro\",sans-serif;cursor:pointer}.ds-selector:hover{background:var(--pale)}.ds-selector[aria-pressed=\"true\"]{background:var(--ink);border-color:var(--ink);color:#fff}.ds-selector:focus-visible{outline:3px solid var(--blue);outline-offset:5px}@media(max-width:760px){.ds-selector{min-height:38px;padding:8px 12px;font-size:10px}}"
    },
    {
      "name": "Enamel summary",
      "kind": "card",
      "refersTo": "enamel-panel",
      "description": "Flat tonal container for a booking estimate.",
      "html": "<aside class=\"ds-panel\"><h2>Đơn giặt của bạn</h2><div class=\"ds-total\"><span>Tạm tính</span><strong>0 đ</strong></div></aside>",
      "css": ".ds-panel{padding:24px;border-radius:var(--radius);background:var(--enamel);color:var(--ink);font:400 12px/1.7 \"Be Vietnam Pro\",sans-serif}.ds-panel h2{margin:0;padding-bottom:20px;border-bottom:1px solid #b8cbde;font-size:19px;font-weight:600;letter-spacing:-.035em}.ds-total{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:18px 0 8px}.ds-total strong{font-size:23px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.03em}@media(max-width:760px){.ds-panel{padding:22px}}"
    },
    {
      "name": "Primary navigation",
      "kind": "nav",
      "refersTo": "navigation-surface",
      "description": "Soft desktop navigation frame and selected surface; mobile releases frame.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Điều hướng chính\"><a href=\"#home\" aria-current=\"page\">Trang chủ</a><a href=\"#prices\">Bảng giá</a><a href=\"#track\">Tra cứu đơn</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:5px;align-items:center;padding:5px;background:#edf1f3;border-radius:12px}.ds-nav a{padding:9px 15px;border-radius:8px;color:var(--muted);font:500 13px/1.7 \"Be Vietnam Pro\",sans-serif;text-decoration:none}.ds-nav a[aria-current]{background:var(--white);color:var(--ink);box-shadow:0 3px 8px #183b690c}.ds-nav a:hover{color:var(--blue)}.ds-nav a:focus-visible{outline:3px solid var(--blue);outline-offset:5px}@media(max-width:760px){.ds-nav{background:none;padding-inline:0;border-radius:0;flex-direction:column;align-items:stretch;width:100%}.ds-nav a{padding:12px;border-top:1px solid var(--line)}.ds-nav a[aria-current]{background:var(--enamel);box-shadow:none}}"
    },
    {
      "name": "Soft service card",
      "kind": "card",
      "refersTo": "service-card",
      "description": "A separate home service tile; repeated grid positions receive sand/sage fills and staggered offsets.",
      "html": "<a class=\"ds-service\" href=\"#booking\"><h3>Service</h3><p>Care and pricing details</p><span>From <strong>20.000</strong></span></a>",
      "css": ".ds-service{display:block;background:var(--surface-blue,#edf4fb);color:var(--ink);border:0;border-radius:16px;padding:28px;min-height:254px;text-decoration:none;font-family:\"Be Vietnam Pro\",sans-serif;transition:background-color 180ms ease-out}.ds-service:hover{background:#e0eaf6}.ds-service h3{margin:0 0 8px;font-size:22px;font-weight:600;line-height:1.5}.ds-service p{margin:0;color:var(--muted);font-size:14px;line-height:1.85;min-height:52px;max-width:30ch}.ds-service>span{display:block;font-size:12px;color:var(--muted);margin-top:22px}.ds-service strong{color:var(--ink);font-size:18px;font-weight:600}.ds-service:focus-visible{outline:3px solid var(--blue);outline-offset:5px}@media(max-width:760px){.ds-service{padding:20px 16px;min-height:253px}.ds-service h3{font-size:17px}.ds-service p{font-size:12px;line-height:1.8;min-height:67px}.ds-service>span{font-size:10px;margin-top:18px}.ds-service strong{font-size:14px}}@media(prefers-reduced-motion:reduce){.ds-service{transition-duration:.01ms}}"
    }
  ],
  "narrative": {
    "northStar": "Blue Enamel Wash Controls",
    "overview": "Blue Enamel Wash Controls. The user requested reverting the WebGL replacement to the prior CSS washer panel. Warm paper, cobalt actions, pale enamel and Be Vietnam Pro remain the visual identity. The live service selector sits inside the circular dial, and native scroll changes the panel's perspective. Rounded staggered service cards remain below. The source of truth is app/globals.css followed by app/home.css.",
    "keyCharacteristics": [
      "Pale enamel CSS washer panel.",
      "Service readout inside the dial.",
      "Native scroll perspective with reduced-motion fallback.",
      "Soft staggered service cards."
    ],
    "rules": [],
    "dos": [
      "Preserve user-selected CSS presentation and readable Vietnamese controls."
    ],
    "donts": [
      "Do not reintroduce the rejected WebGL replacement without a request."
    ]
  }
}
