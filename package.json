  "scripts": {
    "dev": "next dev",
    "demo:local": "node scripts/demo-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-gate.mjs",
    "test:gate": "node scripts/test-gate.mjs",
    "test:qr": "node --test tests/browser/qr.test.mjs",
    "test:customer": "node --test --test-reporter=tap --test-concurrency=1 tests/customer/google.test.mjs tests/customer/database.test.mjs tests/customer/ui.test.mjs tests/customer/browser.test.mjs tests/customer/shop-copy.test.mjs",
    "check:phase": "node scripts/full-gate.mjs",
    "test:admin": "node --test --test-concurrency=1 tests/admin/usability.test.mjs tests/admin/browser.test.mjs",
    "test:clarity": "node --test --test-concurrency=1 tests/admin/action-guidance.test.mjs tests/browser/clarity-home.test.mjs",
    "test:pricing": "node --test --test-concurrency=1 tests/browser/pricing.test.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
